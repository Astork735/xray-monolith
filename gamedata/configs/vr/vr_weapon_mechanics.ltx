; VR weapon mechanics overrides.
;
; Every weapon's mechanics are worked out from its engine class, its ltx,
; its first-person animations and its model, and written to the log:
;   * [VR mechanics] wpn_svd: rifle, self_loading, detachable(10), ...
; A section here, named after the weapon section (or its parent_section),
; corrects any of them. Only the keys given change.
;
; family    = unknown | pistol | revolver | bolt_action | lever_action |
;             pump_shotgun | break_action | semi_shotgun | rifle | smg |
;             machine_gun | launcher
; action    = none | self_loading | manual_bolt | lever | pump | break |
;             revolver | launcher
; feed      = none | detachable | internal_rounds | tube | belt | cylinder |
;             chambers | muzzle
; capacity  = rounds
; has_bolt_catch, has_bolt_release, has_slide_stop, has_slide_release,
; requires_manual_charging, supports_last_round_hold_open,
; has_charging_handle, has_dust_cover, magazine_removable,
; vr_reload_supported = true | false
;   (vr_reload_supported = false leaves the weapon on the game's own reload)
;
; Examples:
;
; [wpn_some_semi_rifle]
; family = rifle
; action = self_loading
;
; [wpn_some_bolt_rifle]
; family = bolt_action
; action = manual_bolt
; feed = internal_rounds
;
; [wpn_some_ar15]
; has_bolt_catch = true
; supports_last_round_hold_open = true

; ---------------------------------------------------------------------------
; Firearm knowledge the vanilla models do not show (their animations have no
; last-shot hold-open). Variants use these through their parent_section or
; their name trimmed at underscores (wpn_m4a1_custom -> wpn_m4a1).
;
; Holds open on the last round; released by its bolt catch / release lever
; (the support trigger on it, or A).
; AR-15 family, SCAR, SIG 55x, G36/XM8, L85, AUG A3, F2000, MDR, MSBS, FAL,
; M14, MP7, Vector, Skorpion vz.61, UMP.

[wpn_m4]
supports_last_round_hold_open = true
has_bolt_catch = true
requires_manual_charging = false

