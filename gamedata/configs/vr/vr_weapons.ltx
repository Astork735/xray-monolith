; Native VR weapon profiles. A section is vr_wpn_<weapon section>.
; CVrWeaponInteraction reads the keys used by AK-74 and USP below. All
; physical capabilities are opt-in; absent keys do not imply a magazine,
; chamber, slide stop, or movable bolt. Paths and bind positions are checked
; against the active HUD model before enabling a physical interaction.
; Geometry is in metres in the HUD model's bind coordinate system.
;
; The stock PM uses the same interaction component as the rifles and other
; pistols. Its small adapter retains the PM firing obstruction check.
[vr_wpn_wpn_pm]
expected_visual         = anomaly_weapons\wpn_pm\wpn_pm_hud.ogf
two_handed              = false
detachable_magazine     = true
chamber                 = true
slide_stop              = true
grip_offset             = 0, -0.025, -0.015
mag_bone                = magazin
; Stock magazine-only meshes contain 0..8 separate visible cartridges.
magazine_visual_prefix  = vr\wpn_pm_mag_
magazine_visual_max_rounds = 8
mag_extra_bone_1        = sprezyna
mag_extra_bone_2        = siodelko
rounds_bone             = bullets
expected_mag_bind       = 0, -0.023715, -0.000478
mag_grip                = 0, 0.071, -0.00067
mag_base                = 0, -0.071, 0.00067
mag_box_center          = 0.000055, -0.02089, 0.00067
mag_box_half            = 0.00752, 0.05049, 0.02023
extraction              = 0.095
guide_radius            = 0.010
cycle_bone              = slide
expected_cycle_bind     = 0, 0.035553, 0.065958
cycle_grab              = 0, 0.035553, 0.065958
cycle_travel            = 0.035
grab_radius             = 0.09
muzzle_offset           = 0, 0.031445, 0.116943
shell_offset            = 0.008423, 0.038430, 0.034704

